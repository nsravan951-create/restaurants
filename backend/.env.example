PORT=5000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/qr_restaurant
DATABASE_SSL=false
DB_CONNECT_TIMEOUT_MS=5000
DB_STARTUP_TIMEOUT_MS=10000
DB_POOL_MAX=10

# Comma-separated allowed browser origins (include your frontend URL)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500

# Site origin only (no /table.html). QRs: https://autoresto.in/table.html?id=71
FRONTEND_PUBLIC_URL=https://autoresto.in
BACKEND_PUBLIC_URL=https://api.autoresto.in

JWT_SECRET=change-this-to-a-long-random-secret
SUPER_ADMIN_SETUP_KEY=change-this-setup-key

# Cashfree (server-only). Get sandbox keys: merchant.cashfree.com → Developers → API Keys (Sandbox)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_VERSION=2026-01-01
# Customer return URL after Cashfree checkout (must match your frontend table page)
CASHFREE_RETURN_URL=http://localhost:5500/table.html
# Webhook URL (HTTPS). For local dev use ngrok: https://xxxx.ngrok-free.app/api/payments/cashfree/webhook
CASHFREE_WEBHOOK_URL=
# Set true for sandbox without ngrok — payment verified via /cashfree/status polling on return
CASHFREE_WEBHOOK_OPTIONAL=true

# Table session timeout in minutes
TABLE_SESSION_TIMEOUT_MINUTES=20
