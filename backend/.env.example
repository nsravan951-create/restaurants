PORT=5000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/qr_restaurant
DATABASE_SSL=false

# Comma-separated allowed browser origins (include your frontend URL)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500

# Site origin only (no /table.html). QRs: https://autoresto.in/table.html?id=71
FRONTEND_PUBLIC_URL=https://autoresto.in
BACKEND_PUBLIC_URL=

JWT_SECRET=change-this-to-a-long-random-secret
SUPER_ADMIN_SETUP_KEY=change-this-setup-key

# Cashfree credentials are server-only. Leave blank until the official SDK/API integration is supplied.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_VERSION=
CASHFREE_RETURN_URL=https://autoresto.in/table.html
CASHFREE_WEBHOOK_URL=

# Table session timeout in minutes
TABLE_SESSION_TIMEOUT_MINUTES=20
