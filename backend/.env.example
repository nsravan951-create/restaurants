PORT=5000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/qr_restaurant
DATABASE_SSL=false
DB_CONNECT_TIMEOUT_MS=5000
DB_STARTUP_TIMEOUT_MS=10000
DB_POOL_MAX=10

# Comma-separated allowed browser origins (include your frontend URL)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500

# Site origin only (no /table.html). QRs: https://autoresto.in/table.html?id=71
FRONTEND_PUBLIC_URL=https://autoresto.in
# Use Render URL until api.autoresto.in DNS CNAME is set
BACKEND_PUBLIC_URL=https://restaurant-backend-rxqz.onrender.com

JWT_SECRET=change-this-to-a-long-random-secret
SUPER_ADMIN_SETUP_KEY=change-this-setup-key

# Cashfree (server-only). Get sandbox keys: merchant.cashfree.com → Developers → API Keys (Sandbox)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_VERSION=2026-01-01
# Cashfree browser return hits the backend first; backend verifies and redirects to payment-success.html
CASHFREE_RETURN_URL=http://localhost:5000/api/payments/cashfree/return
# Production example: CASHFREE_RETURN_URL=https://restaurant-backend-rxqz.onrender.com/api/payments/cashfree/return
# Optional override for the customer success page (defaults to FRONTEND_PUBLIC_URL/payment-success.html)
# CASHFREE_PAYMENT_SUCCESS_URL=https://autoresto.in/payment-success.html
# Webhook URL (HTTPS). For local dev use ngrok: https://xxxx.ngrok-free.app/api/payments/cashfree/webhook
CASHFREE_WEBHOOK_URL=
# Set true for sandbox without ngrok — payment verified via /cashfree/status polling on return
CASHFREE_WEBHOOK_OPTIONAL=true

# Table session timeout in minutes
TABLE_SESSION_TIMEOUT_MINUTES=20

# Resend (optional — daily settlement ledger emails for owners)
RESEND_API_KEY=
RESEND_FROM_EMAIL=AutoResto Ledger <ledger@autoresto.in>
