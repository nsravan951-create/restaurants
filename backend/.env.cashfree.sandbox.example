# Copy these into backend/.env for TEMPORARY local Cashfree sandbox testing.
# Get Client ID + Secret from: https://merchant.cashfree.com/merchants/pg/developers/api-keys (Sandbox mode)

CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_VERSION=2026-01-01

# Your sandbox App ID and Secret Key (never commit real values)
CASHFREE_CLIENT_ID=your_sandbox_app_id
CASHFREE_CLIENT_SECRET=your_sandbox_secret_key

# Where customer returns after payment (local frontend)
CASHFREE_RETURN_URL=http://localhost:5500/table.html

# Public HTTPS URL pointing to your backend webhook (use ngrok for local dev)
# Example: https://abc123.ngrok-free.app/api/payments/cashfree/webhook
CASHFREE_WEBHOOK_URL=https://YOUR_NGROK_SUBDOMAIN.ngrok-free.app/api/payments/cashfree/webhook

# Optional: allow backend startup when webhook is not reachable yet (status polling still works)
# CASHFREE_WEBHOOK_OPTIONAL=true
